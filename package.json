{
  "name": "skillforge-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/check-production-config.mjs && next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "db:init": "node scripts/db-init.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore": "node scripts/restore-db.mjs",
    "auth:bootstrap": "tsx scripts/bootstrap-user.ts",
    "ownership:recover": "tsx scripts/recover-legacy-workflows.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.6",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.12",
    "tailwindcss": "^4.1.14",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.8.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.3",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.6",
    "tsx": "^4.20.6"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
